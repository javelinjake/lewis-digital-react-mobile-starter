# Local development needs none of these: the defaults use the Docker Postgres from tooling/cms and capture email to .data/mail.

# --- Required in production -------------------------------------------------
# Neon's Vercel integration sets DATABASE_URL and DATABASE_URL_UNPOOLED (used for migrations).
DATABASE_URL=
PAYLOAD_SECRET=
BETTER_AUTH_SECRET=
# Public URL of this backend. On Vercel it falls back to the deployment URL.
SERVER_URL=
# Comma separated web origins allowed to call this API (the PWA). Native WebViews are added from app.meta.
APP_ORIGINS=

# --- Email (verification and password reset) --------------------------------
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
EMAIL_FROM=App <app@notifications.example.com>

# --- First administrator (read by cms:bootstrap-admin) ----------------------
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# --- Sign in with Apple / Google (only the methods enabled in payload.config.ts) ---
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Purchases and cron ------------------------------------------------------
# Set the same value as the Authorization header of the RevenueCat webhook.
REVENUECAT_WEBHOOK_SECRET=
# Vercel Cron sends this as `Authorization: Bearer <value>`.
CRON_SECRET=

# --- Game testing ------------------------------------------------------------
# 1 lets a request set the server clock with an X-Debug-Now header (epoch ms or ISO), to skip ahead in time.
# Local and playtest only: production refuses to start with it.
ALLOW_TIME_TRAVEL=

# --- Private media: local disk by default, GCS when all four are set ---------
MEDIA_STORAGE=local
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=
GCS_PREFIX=
