# Copy to .env.local for development. Anything starting with VITE_ is public and ends up in the app bundle.
# Never put a secret here. Secrets belong to the api app.

# mock: an in-memory backend, nothing to run. live: the api app (pnpm --filter @ld/api-template dev).
VITE_DATA_MODE=mock

# Web: leave empty. The app calls /api on its own origin; vite dev and vercel.json forward it to the api app.
# Native (Capacitor): the https address of the deployed api app, e.g. https://api.example.com
VITE_API_URL=

# Public origin of the web app. Used for the links in verification and reset emails. Falls back to the current origin.
VITE_FRONTEND_URL=
