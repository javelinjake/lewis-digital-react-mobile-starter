{
  "name": "@ld/api-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./types": "./payload-types.ts"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "build:vercel": "tsx scripts/vercel-build.ts",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "ts": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "architecture:check": "bash ../../../tooling/architecture-check/architecture-check.sh .",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate:create": "tsx scripts/with-migration-uri.ts migrate:create",
    "cms:migrate": "tsx scripts/with-migration-uri.ts migrate",
    "cms:migrate:status": "tsx scripts/with-migration-uri.ts migrate:status",
    "cms:bootstrap-admin": "tsx scripts/cms-bootstrap-admin.ts"
  },
  "dependencies": {
    "@delmaredigital/payload-better-auth": "catalog:",
    "@ld/backend": "workspace:*",
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/ui": "catalog:",
    "better-auth": "catalog:",
    "graphql": "catalog:",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@ld/api-client": "workspace:*",
    "@ld/config-eslint": "workspace:*",
    "@ld/config-typescript": "workspace:*",
    "@ld/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
