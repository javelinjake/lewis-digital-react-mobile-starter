# Copy to .env.local for development. Anything starting with VITE_ is public and ends up in the app bundle.
# Never put a secret here. Secrets belong to the api app.

# mock: an in-memory backend, nothing to run. live: the api app (pnpm --filter @ld/api-template dev).
VITE_DATA_MODE=mock

# Web: leave empty. The app calls /api on its own origin; vite dev and vercel.json forward it to the api app.
# Native (Capacitor): leave empty to use environments.<APP_ENV>.apiUrl from app.meta.ts; set it to override.
VITE_API_URL=

# Public origin of the web app. Used for the links in verification and reset emails. Falls back to the current origin.
VITE_FRONTEND_URL=

# Crash reports (Sentry). The DSN is a public key. Production builds offer "Send crash reports" in Settings when set.
VITE_SENTRY_DSN=

# Not VITE_: read by the build, never bundled. With all three set, a production build uploads hidden source maps to
# Sentry and deletes them from the output. Set them on Vercel and in your shell for native releases.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
